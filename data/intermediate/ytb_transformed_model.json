{
  "identifier": string,          // "youtube-" + id
  "class": string,               // always "dctype:MovingImage"
  "title": string,               // snippet.title
  "description": string,         // snippet.description
  "date_issued": date,           // snippet.publishedAt (YYYY-MM-DD)
  "date_created": date | null,   // liveStreamingDetails.actualStartTime (old live streams only)
  "creator": string,             // snippet.channelTitle
  "publisher": string,           // snippet.channelTitle + " (YouTube)"
  "publisher_uri": string,       // "https://www.youtube.com/channel/" + snippet.channelId
  "rights": string,              // always "Standard YouTube License – Credit: NASA"
  "language": string,            // snippet.defaultLanguage, else defaultAudioLanguage, else "en"
  "extent": string,              // contentDetails.duration converted, e.g. "1:01:45"
  "format": string,              // always "Video (YouTube)"
  "views": integer,              // statistics.viewCount (0 if missing)
  "likes": integer,              // statistics.likeCount (0 if missing)
  "comments": integer | null,    // statistics.commentCount (rarely present)
  "stats_date": date,            // day the transform was run
  "topics": [string],            // topicDetails.topicCategories (Wikipedia URLs)
  "source": string,              // "https://www.youtube.com/watch?v=" + id
  "subjects": [                  // UAT terms (empty for now)
    {
      "uri": string,             // e.g. "http://astrothesaurus.org/uat/2291"
      "label": string            // e.g. "James Webb Space Telescope"
    }
  ],
  "media": {
    "ingester": string,          // always "youtube"
    "url": string                // same as source
  }
}